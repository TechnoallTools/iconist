#: admin/class-iconist-admin.php:16
msgid "تنظیمات آیکونیست"
msgstr "Iconist Settings"

#. Plugin Name of the plugin/theme
#: admin/class-iconist-admin.php:17 admin/class-iconist-admin.php:97
msgid "آیکونیست"
msgstr "Iconist"

#: admin/class-iconist-admin.php:51
msgid "در حال تبدیل..."
msgstr "Converting..."

#: admin/class-iconist-admin.php:52 admin/class-iconist-admin.php:271
msgid "تبدیل همه آیکون‌ها"
msgstr "Convert All Icons"

#: admin/class-iconist-admin.php:53
msgid "همه تبدیل‌ها انجام شد!"
msgstr "All icons have been converted successfully!"

#: admin/class-iconist-admin.php:54
msgid "تبدیل به‌دلیل خطا متوقف شد."
msgstr "Conversion stopped due to an error."

#: admin/class-iconist-admin.php:55
msgid "آیا مطمئن هستید؟ تمام SVGهای موجود در رسانه وردپرس تبدیل می‌شوند."
msgstr ""
"Are you sure? All SVG files in the WordPress Media Library will be converted."

#: admin/class-iconist-admin.php:56
msgid "در حال محاسبه تعداد فایل‌ها..."
msgstr "Counting SVG files..."

#: admin/class-iconist-admin.php:57
msgid "هیچ فایل SVG برای تبدیل پیدا نشد."
msgstr "No SVG files found to convert."

#: admin/class-iconist-admin.php:58
msgid "فایل SVG برای تبدیل پیدا شد."
msgstr "SVG file found for conversion."

#: admin/class-iconist-admin.php:59
msgid "در حال تبدیل:"
msgstr "Converting:"

#: admin/class-iconist-admin.php:60
msgid "تلاش مجدد..."
msgstr "Retrying..."

#: admin/class-iconist-admin.php:61
msgid "خطای شبکه — تلاش مجدد"
msgstr "Network error — Retrying"

#: admin/class-iconist-admin.php:62 admin/class-iconist-admin.php:442
msgid "تأیید فرایند"
msgstr "Confirm Conversion"

#: admin/class-iconist-admin.php:63 admin/class-iconist-admin.php:445
msgid "انصراف"
msgstr "Cancel"

#: admin/class-iconist-admin.php:64 admin/class-iconist-admin.php:446
msgid "ادامه"
msgstr "Continue"

#: admin/class-iconist-admin.php:80
msgid "تنظیمات آیکونیست با موفقیت ذخیره شد."
msgstr "Iconist settings saved successfully."

#: admin/class-iconist-admin.php:115
msgid "تنظیمات عمومی"
msgstr "General Settings"

#: admin/class-iconist-admin.php:128 admin/class-iconist-admin.php:257
msgid "تبدیل دسته‌جمعی"
msgstr "Bulk Conversion"

#: admin/class-iconist-admin.php:144
msgid "استثناها"
msgstr "Exclusions"

#: admin/class-iconist-admin.php:161 admin/class-iconist-admin.php:380
msgid "وضعیت سرور"
msgstr "Server Status"

#: admin/class-iconist-admin.php:169
msgid "افزونه فعال است"
msgstr "Plugin Active"

#: admin/class-iconist-admin.php:176
msgid "رایگان برای همیشه"
msgstr "Free Forever"

#: admin/class-iconist-admin.php:196
msgid "درباره افزونه"
msgstr "About Iconist"

#: admin/class-iconist-admin.php:199
msgid ""
"آیکونیست به‌صورت خودکار تمام فایل‌های SVG آپلود‌شده در رسانه وردپرس را دریافت "
"می‌کند و با ایجاد تغییراتی، آیکون ها را برای استفاده و تغییر رنگ در المنتور "
"آماده می‌کند."
msgstr ""
"Iconist automatically processes all SVG files uploaded to the WordPress Media "
"Library and optimizes them for seamless use and color customization in "
"Elementor."

#: admin/class-iconist-admin.php:211
msgid "تنظیمات تبدیل"
msgstr "Conversion Settings"

#: admin/class-iconist-admin.php:217
msgid "تبدیل خودکار هنگام آپلود"
msgstr "Automatically Convert on Upload"

#: admin/class-iconist-admin.php:218
msgid "هر SVG جدیدی که آپلود می‌شود به‌صورت خودکار تبدیل می‌گردد"
msgstr "Automatically convert every newly uploaded SVG file."

#: admin/class-iconist-admin.php:228
msgid "ذخیره نسخه پشتیبان قبل از تبدیل"
msgstr "Create a Backup Before Conversion"

#: admin/class-iconist-admin.php:229
msgid ""
"قبل از هر تبدیل، یک نسخه پشتیبان از فایل اصلی با پسوند -iconist-backup ذخیره "
"می‌شود"
msgstr ""
"A backup of the original file will be created before each conversion, using "
"the -iconist-backup suffix."

#: admin/class-iconist-admin.php:242
msgid "ذخیره تنظیمات"
msgstr "Save Settings"

#: admin/class-iconist-admin.php:260
msgid ""
"این ابزار تمام فایل‌های SVG موجود در رسانه وردپرس را پیدا کرده و آن‌ها را برای "
"استفاده در المنتور آماده می‌کند."
msgstr ""
"This tool finds all SVG files in your WordPress Media Library and converts "
"them for seamless use in Elementor."

#: admin/class-iconist-admin.php:287
msgid "گزارش تبدیل"
msgstr "Conversion Report"

#: admin/class-iconist-admin.php:288
msgid "پاک کردن"
msgstr "Clear"

#: admin/class-iconist-admin.php:300
msgid "همه فایل‌ها با موفقیت تبدیل شدند!"
msgstr "All files have been converted successfully!"

#: admin/class-iconist-admin.php:317
msgid "فایل‌های استثنا"
msgstr "Excluded Files"

#: admin/class-iconist-admin.php:320
msgid "فایل‌های SVG زیر هنگام آپلود و تبدیل دسته‌جمعی دست نخورده باقی می‌مانند."
msgstr ""
"The following SVG files will be excluded from automatic and bulk conversion."

#: admin/class-iconist-admin.php:330
msgid "افزودن از رسانه وردپرس"
msgstr "Add from WordPress Media Library"

#: admin/class-iconist-admin.php:338
msgid "هیچ استثنایی تعریف نشده."
msgstr "No exclusions have been added."

#: admin/class-iconist-admin.php:357
msgid "حذف"
msgstr "Remove"

#: admin/class-iconist-admin.php:407
msgid "اطلاعات سایت"
msgstr "Site Information"

#: admin/class-iconist-admin.php:423
msgid "زبان سایت"
msgstr "Site Language"

